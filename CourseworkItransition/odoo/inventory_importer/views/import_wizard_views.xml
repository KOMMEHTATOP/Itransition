<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_inventory_import_wizard_form" model="ir.ui.view">
        <field name="name">inventory.import.wizard.form</field>
        <field name="model">inventory.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Inventory">
                <group>
                    <field name="base_url"/>
                    <field name="api_token" password="True"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_inventory_import_wizard" model="ir.actions.act_window">
        <field name="name">Import</field>
        <field name="res_model">inventory.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_inventory_import_wizard"
              name="Import"
              parent="menu_inventory_importer_root"
              action="action_inventory_import_wizard"
              sequence="20"/>

</odoo>
